APP_NAME=finassist-mini
APP_VERSION=0.1.0
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=80
OLLAMA_PORT=11434
DOCKER_SHARED_NETWORK=fintech-rag-network

# Persistence paths inside backend container
DOCS_DIRECTORY=/app/data/documents
REPOSITORY_STORAGE_PATH=/app/storage/repositories

# Ollama models
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_URL=http://ollama:11434
LLM_MODEL=tinyllama
RETRIEVAL_K=3
CHUNK_SIZE_WORDS=350
CHUNK_OVERLAP_WORDS=35
LLM_TIMEOUT_SECONDS=90
MAX_PROMPT_CHARS=6000
MAX_UPLOAD_SIZE_MB=25
UPLOAD_WRITE_CHUNK_BYTES=1048576
UPLOAD_MAX_CONCURRENCY=1
CHAT_MAX_CONCURRENCY=1
ADMISSION_WAIT_SECONDS=1.0

# PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/fintech_rag
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Keycloak configuration
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/finassist
KEYCLOAK_REALM=finassist
KEYCLOAK_ADMIN_CLIENT_ID=finassist-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-real-client-secret

# Frontend Vite build configuration
VITE_API_BASE_URL=/api
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=finassist
VITE_KEYCLOAK_CLIENT=finassist-app
VITE_DEV_API_TARGET=http://localhost:8080
VITE_DEV_SERVER_PORT=3000

# Backend runtime options
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
